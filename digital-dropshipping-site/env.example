# ============================================================
# Unitiv environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ============================================================

# --- Database (MySQL) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_POOL_LIMIT=15
MYSQL_SSL=false

# --- Auth ---
# Required in production. Generate with: openssl rand -base64 48
SESSION_SECRET=

# --- Cron ---
# Shared secret for scheduled endpoints (e.g. /api/milestones/auto-approve).
# Send as "x-cron-secret" header or "Authorization: Bearer <secret>".
CRON_SECRET=

# --- Stripe ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# --- Email (nodemailer) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
