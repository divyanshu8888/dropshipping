# ===========================================
# DIGITAL DROPSHIPPING SITE - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control!

# ===========================================
# DATABASE - MySQL
# ===========================================
# MySQL connection settings (for local or remote MySQL server)
# IMPORTANT: Never commit .env.local with real passwords!
# 
# Required: All MYSQL_* variables must be set
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=your_database_name
MYSQL_SSL=false


# ===========================================
# PAYMENT PROCESSING (Stripe)
# ===========================================
# Get these from your Stripe dashboard
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# ===========================================
# AUTHENTICATION (NextAuth)
# ===========================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_key_here

# ===========================================
# SITE CONFIGURATION
# ===========================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Uniti Platform

# ===========================================
# EXTERNAL APIS (Optional)
# ===========================================
# Uniti API (if using external talent platform)
UNITI_API_KEY=your_uniti_api_key_here

# Email Service (if using external email provider)
EMAIL_SERVICE_API_KEY=your_email_service_key_here
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
NODE_ENV=development
DEBUG=false

# ===========================================
# SECURITY NOTES
# ===========================================
# 1. Use strong, unique passwords for all services
# 2. Rotate API keys regularly
# 3. Use different keys for development/production
# 4. Never share these credentials
# 5. Monitor API usage for unusual activity
