# ============================================================
# Unitiv environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ============================================================

# --- Database (MySQL) — REQUIRED, site will not start without these ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_POOL_LIMIT=15
MYSQL_SSL=false

# --- Auth — REQUIRED in production (login breaks without it) ---
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# --- Email via SMTP (nodemailer) — REQUIRED for password reset,
#     email/phone change OTPs, and quote notifications ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=

# --- Cron — REQUIRED if you schedule milestone auto-approval ---
# Send as "x-cron-secret" header or "Authorization: Bearer <secret>"
# to /api/milestones/auto-approve.
CRON_SECRET=

# --- AI content moderation — RECOMMENDED (free with OpenAI) ---
# First configured key wins. Without one, the keyword/pattern filter
# still runs; the AI meaning-based pass is skipped.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Unitiv

# --- Future / currently unused ---
# Stripe is installed but checkout/payouts are stubs — add when payments go live.
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# Dropship provider integration (legacy, stubbed):
# DROPSHIP_PROVIDER_API_URL=
# DROPSHIP_PROVIDER_API_KEY=
